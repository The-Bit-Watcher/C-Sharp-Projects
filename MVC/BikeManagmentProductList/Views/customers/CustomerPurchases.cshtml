@model Assignment3.Models.CombinedPurchaseCreateViewModel

@{
    ViewBag.Title = "Customer Purchases";
}

<h2>Customer Purchases</h2>

<button type="button" class="btn-primary mb-3" data-bs-toggle="modal" 
        data-bs-target="#createCustomerModal">
    Create new Customer   
    </button>
@using (Html.BeginForm("SubmitStaff", "Home", FormMethod.Post))
{
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-4">
                <div class="p-3" style="background-color: #f0f0f0; border-radius: 5px;">
  
                    <h5>Existing Customers</h5>
                    <div style="max-height: 200px; overflow-y: auto;">
                        <table class="table table-bordered table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Total Orders</th>
                                    <th>Select</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in Model.CustomerPurchases)
                                {
                                    <tr>
                                        <td>@customer.CustomerId</td>
                                        <td>@customer.CustomerName</td>
                                        <td>@customer.Email</td>
                                        <td>@customer.Purchases.Count</td>
                                        <td>
                                            @if (customer.Purchases != null && customer.Purchases.Any())
                                            {
                                                <ul style="list-style-type: none; padding-left: 0; margin-bottom: 0;">
                                                    @foreach (var purchase in customer.Purchases)
                                                    {
                                                        <li>
                                                            <strong>@purchase.ProductName</strong>
                                                            - @purchase.ListPrice.ToString("C")
                                                            (Ordered: @purchase.OrderDate.ToString("MM/dd/yyyy"))
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No purchases</span>
                                            }
                                        </td>
                                        <td>
                                            <input type="checkbox" name="SelectedCustomers" value="@customer.CustomerId" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3 w-100">Submit</button>
                </div>
            </div>
            <div class="col-md-8"></div>
        </div>
    </div>
}

<<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-labelledby="createCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "customers", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="createCustomerModalLabel">Create New Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NewCustomer.first_name, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.NewCustomer.first_name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NewCustomer.first_name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NewCustomer.last_name, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.NewCustomer.last_name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NewCustomer.last_name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NewCustomer.phone, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.NewCustomer.phone, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NewCustomer.phone, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NewCustomer.email, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.NewCustomer.email, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NewCustomer.email, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NewCustomer.street, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.NewCustomer.street, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NewCustomer.street, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NewCustomer.city, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.NewCustomer.city, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NewCustomer.city, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NewCustomer.state, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.NewCustomer.state, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NewCustomer.state, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NewCustomer.zip_code, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.NewCustomer.zip_code, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NewCustomer.zip_code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Customer</button>
                </div>
            }
        </div>
    </div>
</div>