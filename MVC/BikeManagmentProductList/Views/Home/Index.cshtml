@functions {
    // Helper function to map product names to image file names
    private string GetImageName(string productName)
    {
        var imageMappings = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
{
            {"Electra Cruiser 1", "Electra_Cruiser 1.jpeg"},
            {"Electra Cruiser", "Electra_Cruiser.jpeg"},
            {"Haro Bikes 1", "Haro_Bikes1.jpeg"},
            {"Haro Mountain Bike", "Haro_mountain_bike.jpeg"},
            {"Heler Bike 2", "Heler_bike2.jpeg"},
            {"Heller Bike 1", "Heller_bike1.jpeg"},
            {"Pure Cycles 1", "Pure_Cycles1.jpeg"},
            {"Sun Bicycles Retro", "Sun_bicycles_retro.jpeg"},
            {"Sun Bicycles 1", "Sun_Bicycles1.jpeg"},
            {"Surly Bike", "Surly_bike.jpeg"},
            {"Surly Preamble Bike", "Surly_preamble_bike.jpeg"},
            {"Trek Marlin Bike", "Trek_Marlin_bike.jpeg"},
            {"Trek Xcaliber Bike", "Trek Xcaliber_bike.jpeg"}
        };

        // Try exact match first
        if (imageMappings.ContainsKey(productName))
            return imageMappings[productName];

        // Try partial match
        foreach (var mapping in imageMappings)
        {
            if (productName.Contains(mapping.Key) || mapping.Key.Contains(productName))
                return mapping.Value;
        }

        return "placeholder.jpeg"; // Fallback image
    }

    // Helper function to check if file exists
    private bool FileExists(string filePath)
    {
        try
        {
            return System.IO.File.Exists(filePath);
        }
        catch
        {
            return false;
        }
    }
}