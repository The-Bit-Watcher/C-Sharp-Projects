                                    @Html.LabelFor(model => model.CustomersData.NewCustomer.first_name, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CustomersData.NewCustomer.first_name, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.CustomersData.NewCustomer.first_name, "", new { @class = "text-danger" })
