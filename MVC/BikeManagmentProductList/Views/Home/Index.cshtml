                                    @Html.EditorFor(model => model.CustomersData.NewCustomer.street, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.CustomersData.NewCustomer.street, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CustomersData.NewCustomer.city, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CustomersData.NewCustomer.city, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.CustomersData.NewCustomer.city, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CustomersData.NewCustomer.state, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CustomersData.NewCustomer.state, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.CustomersData.NewCustomer.state, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CustomersData.NewCustomer.zip_code, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CustomersData.NewCustomer.zip_code, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.CustomersData.NewCustomer.zip_code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Customer</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Staff Modal -->
<div class="modal fade" id="createStaffModal" tabindex="-1" aria-labelledby="createStaffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("CreateStaff", "Home", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="createStaffModalLabel">Create New Staff Member</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.StaffData.NewStaff.first_name, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.StaffData.NewStaff.first_name, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.StaffData.NewStaff.first_name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
