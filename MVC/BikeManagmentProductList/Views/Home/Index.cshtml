                                    @Html.EditorFor(model => model.CustomersData.NewCustomer.last_name, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.CustomersData.NewCustomer.last_name, "", new { @class = "text-danger" })
