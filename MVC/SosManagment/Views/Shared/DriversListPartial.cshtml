@model List<HAS01.Models.Booking.Driver>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Service</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var driver in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(driver.ImagePath))
                    {
                        <img src="@driver.ImagePath" class="img-thumbnail" style="max-height: 50px;" />
                    }
                </td>
                <td>@driver.Name</td>
                <td>@driver.Number</td>
                <td>@driver.DriverType</td>
                <td>
                    @Html.ActionLink("Edit", "EditDriver", new { id = driver.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                    @Html.ActionLink("Delete", "DeleteDriver", new { id = driver.Id }, new { @class = "btn btn-sm btn-outline-danger", onclick = "return confirm('Are you sure you want to delete this driver?');" })
                </td>
            </tr>
        }
    </tbody>
</table>
